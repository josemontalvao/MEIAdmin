@model MEIAdmin.Models.Dispositivo

@{
    ViewData["Title"] = "Adicionar Dispositivo ao Cliente";
}

<div class="container mt-3">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Instalar Dispositivo no Cliente</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- CLIENTE (Já selecionado automaticamente) -->
                <div class="form-group mb-3">
                    <label asp-for="ClienteId" class="control-label fw-bold">Cliente</label>
                    <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.ClienteId"></select>
                    <span asp-validation-for="ClienteId" class="text-danger"></span>
                </div>

                <!-- PUXAR DO ESTOQUE (BAIXA AUTOMÁTICA) -->
                <div class="form-group mb-3 p-3 bg-light rounded border border-primary">
                    <label class="control-label fw-bold text-primary">📦 Puxar do Estoque (Baixar 1 unidade)</label>
                    <select name="produtoId" id="selectProduto" class="form-select" asp-items="ViewBag.Produtos">
                        <option value="">-- Não baixar do estoque (Cadastro avulso) --</option>
                    </select>
                    <small class="text-muted d-block mt-1">
                        Se escolher um item daqui, o sistema subtrai 1 unidade do estoque e preenche o Nome/Modelo se estiverem vazios.
                    </small>
                </div>

                <div class="row">
                    <!-- NOME DO DISPOSITIVO -->
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="Nome" class="control-label fw-bold">Nome / Identificação</label>
                        <input asp-for="Nome" class="form-control" placeholder="Ex: Câmera Portão, Sensor Entrada" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>

                    <!-- MODELO -->
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="Modelo" class="control-label fw-bold">Modelo</label>
                        <input asp-for="Modelo" class="form-control" placeholder="Ex: VHD 1220 B, Intelbras HD" />
                        <span asp-validation-for="Modelo" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <!-- NÚMERO DE SÉRIE -->
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="NumeroSerie" class="control-label fw-bold">Número de Série (NS)</label>
                        <input asp-for="NumeroSerie" class="form-control" placeholder="Ex: NS123456789" />
                        <span asp-validation-for="NumeroSerie" class="text-danger"></span>
                    </div>

                    <!-- DATA DE INSTALAÇÃO -->
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="DataInstalacao" class="control-label fw-bold">Data de Instalação</label>
                        <input asp-for="DataInstalacao" class="form-control" type="date" value="@(Model.DataInstalacao?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" />
                        <span asp-validation-for="DataInstalacao" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-primary px-4">Salvar e Instalar</button>
                    <a asp-action="Dispositivos" asp-controller="Cliente" asp-route-id="@Model.ClienteId" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
