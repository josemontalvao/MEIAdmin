@model IEnumerable<MEIAdmin.Models.ViewModels.RelatorioContasPagarViewModel>

@{
    ViewData["Title"] = "Relatório de Contas a Pagar (Pendentes)";

    var meses = new Dictionary<int, string>
    {
        { 0, "Todos os Meses" },
        { 1, "Janeiro" }, { 2, "Fevereiro" }, { 3, "Março" }, { 4, "Abril" },
        { 5, "Maio" }, { 6, "Junho" }, { 7, "Julho" }, { 8, "Agosto" },
        { 9, "Setembro" }, { 10, "Outubro" }, { 11, "Novembro" }, { 12, "Dezembro" }
    };

    int mesAtual = ViewBag.MesSelecionado ?? 0;
    int anoAtual = ViewBag.AnoSelecionado ?? DateTime.Now.Year;
    string tituloPeriodo = mesAtual > 0 ? $"{meses[mesAtual]} de {anoAtual}" : "Geral (Todos os Períodos)";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Relatório de Contas a Pagar (Pendentes)</h2>
    <button onclick="window.print()" class="btn btn-outline-secondary">
        🖨️ Imprimir / Salvar PDF
    </button>
</div>

<!-- FILTRO DE MÊS E ANO -->
<div class="card mb-4 bg-light shadow-sm">
    <div class="card-body">
        <form method="get" asp-action="ContasPagarPendentes" class="row g-3 align-items-end">
            <div class="col-auto">
                <label class="form-label fw-bold">Mês de Vencimento:</label>
                <select name="mes" class="form-select">
                    @foreach (var m in meses)
                    {
                        <option value="@m.Key" selected="@(m.Key == mesAtual ? "selected" : null)">
                            @m.Value
                        </option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label fw-bold">Ano:</label>
                <input type="number" name="ano" class="form-control" value="@anoAtual" style="width: 110px;" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">🔍 Filtrar</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <!-- CARTÃO DO TOTAL PENDENTE A PAGAR -->
    <div class="card mb-4 border-danger">
        <div class="card-body bg-light">
            <h5 class="card-title text-danger mb-1">Total a Pagar - @tituloPeriodo</h5>
            <h3 class="fw-bold text-danger mb-0">@Model.Sum(g => g.Total).ToString("C")</h3>
            <small class="text-muted">Previsão de saídas de caixa pendentes para o período selecionado</small>
        </div>
    </div>

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Data de Vencimento</th>
                <th>Fornecedor</th>
                <th>Descrição</th>
                <th>Valor</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var grupo in Model)
            {
                <tr class="table-secondary">
                    <td colspan="4" class="fw-bold text-danger py-2">
                        📅 Vencimento: @grupo.DataVencimento.ToString("dd/MM/yyyy")
                    </td>
                </tr>
                @foreach (var conta in grupo.Contas ?? new List<MEIAdmin.Models.ContaPagar>())
                {
                    <tr>
                        <td></td>
                        <td class="fw-bold">@(conta.Fornecedor?.RazaoSocial ?? "Fornecedor não informado")</td>
                        <td>@conta.Descricao</td>
                        <td class="text-danger fw-bold">@conta.Valor.ToString("C")</td>
                    </tr>
                }
                <tr>
                    <td colspan="3" class="text-end fw-bold text-muted">Total deste Vencimento:</td>
                    <td class="fw-bold text-dark border-bottom border-2">@grupo.Total.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info mt-3">
        Nenhuma conta a pagar pendente encontrada para <strong>@tituloPeriodo</strong>.
    </div>
}