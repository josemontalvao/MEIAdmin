@model MEIAdmin.Models.OrdemServico

@{
    Layout = null;
    ViewData["Title"] = $"Laudo Técnico O.S. #{Model.Id}";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Laudo Técnico O.S. #@Model.Id - Smart Control</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
    <style>
        @@media print {
            .d-print-none { display: none !important; }
            body { background: white !important; padding: 0 !important; }
            .card { border: none !important; box-shadow: none !important; }
            .foto-box { height: 260px !important; }
        }
        .foto-box {
            height: 280px;
            background-color: #f8f9fa;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }
    </style>
</head>
<body class="bg-light">

<div class="container mt-3 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3 d-print-none">
        <a asp-action="Index" class="btn btn-secondary">⬅️ Voltar ao Painel</a>
        <button onclick="window.print()" class="btn btn-primary btn-lg shadow">
            🖨️ Imprimir / Salvar PDF
        </button>
    </div>

    <!-- FOLHA TIMBRADA OFICIAL DA SMART CONTROL -->
    <div class="card p-4 shadow-sm border border-secondary bg-white" id="folhaLaudo">
        
        <!-- CABEÇALHO COM LOGO MAIOR -->
        <div class="row align-items-center pb-3 border-bottom border-2 border-primary">
            <div class="col-3 text-center">
                <img src="/img/logo.png" alt="Smart Control" style="max-height: 165px; max-width: 100%; object-fit: contain;" onerror="this.style.display='none'" />
            </div>
            <div class="col-9 ps-3">
                <h4 class="fw-bold text-primary mb-1">SMART CONTROL SYSTEMAS LTDA</h4>
                <p class="mb-0 text-muted" style="font-size: 0.88rem; line-height: 1.35;">
                    CNPJ: 68.516.553/0001-35<br/>
                    Rua Susana Brocart, 520 - Jardim Danfer - São Paulo/SP - CEP: 03758-140<br/>
                    <strong>Tel / WhatsApp: (11) 98818-8255</strong> | E-mail: smartcontrolsystemas@gmail.com<br/>
                    <span class="fw-bold text-dark">SDAI • CFTV • CONTROLE DE ACESSO • AUTOMAÇÃO PREDIAL</span>
                </p>
            </div>
        </div>

        <!-- QUADRO DO CLIENTE E O.S. -->
        <div class="row bg-light p-3 my-3 rounded border align-items-center">
            <div class="col-md-6">
                <h6 class="mb-1"><strong>CLIENTE:</strong> @(Model.Cliente?.RazaoSocial ?? "N/A")</h6>
                <p class="mb-0 text-muted" style="font-size: 0.88rem;">
                    <strong>Endereço:</strong> @Model.Cliente?.Endereco, @Model.Cliente?.Numero - @Model.Cliente?.Bairro - @Model.Cliente?.Cidade/@Model.Cliente?.Estado<br/>
                    <strong>Contato:</strong> @Model.Cliente?.Contato | <strong>Tel:</strong> @Model.Cliente?.Telefone
                </p>
            </div>
            <div class="col-md-6 border-start ps-3">
                <h5 class="text-primary fw-bold mb-1">ORDEM DE SERVIÇO Nº: #@Model.Id</h5>
                <p class="mb-0" style="font-size: 0.88rem; line-height: 1.4;">
                    <strong>Emissão:</strong> @Model.DataAbertura.ToString("dd/MM/yyyy")<br/>
                    <strong>Tipo:</strong> @Model.TipoManutencao | <strong>Status:</strong> <span class="badge bg-success">@Model.Status</span><br/>
                    <strong>Técnico Responsável:</strong> <span class="text-dark fw-bold">@(Model.Colaborador?.Nome ?? "Não informado")</span>
                </p>
            </div>
        </div>

        <!-- DETALHAMENTO DO ATENDIMENTO -->
        <div class="mb-3">
            <p class="mb-1">
                <strong>Período do Atendimento:</strong> 
                De @(Model.DataInicio?.ToString("dd/MM/yyyy HH:mm") ?? "-") até @(Model.DataFim?.ToString("dd/MM/yyyy HH:mm") ?? "-") 
                (Tempo Gasto: <strong>@(Model.TempoGastoHoras?.ToString("F2") ?? "0.00") horas</strong>)
            </p>
            
            <div class="mt-2">
                <h6 class="fw-bold text-dark mb-1">Descrição dos Serviços / Diagnóstico da Vistoria:</h6>
                <div class="p-2 bg-light rounded border" style="font-size: 0.95rem;">
                    @(Model.ServicoExecutado ?? "Nenhum detalhe informado.")
                </div>
            </div>

            <!-- LEVANTAMENTO DE MATERIAIS PARA COMPRA / COTAÇÃO -->
            <div class="mt-2">
                <h6 class="fw-bold text-primary mb-1">🛒 Peças, Materiais Utilizados / Levantamento para Compra:</h6>
                <div class="p-2 bg-light rounded border fw-bold text-dark" style="font-size: 0.95rem; white-space: pre-line;">
                    @(Model.PecasUtilizadas ?? "Nenhum material registrado.")
                </div>
            </div>

            <div class="mt-2">
                <h6 class="fw-bold text-dark mb-1">Observações Técnicas / Recomendações:</h6>
                <div class="p-2 bg-light rounded border" style="font-size: 0.95rem;">
                    @(Model.ObservacoesTecnicas ?? "Sem observações adicionais.")
                </div>
            </div>
        </div>

        <!-- REGISTRO FOTOGRÁFICO DE EVIDÊNCIAS -->
        @if (Model.Fotos != null && Model.Fotos.Any())
        {
            <div class="mt-3">
                <h6 class="fw-bold text-primary border-bottom pb-1">Registro Fotográfico de Evidências:</h6>
                <div class="row mt-2">
                    @for (int i = 0; i < Model.Fotos.Count; i++)
                    {
                        var foto = Model.Fotos[i];
                        <div class="col-6 mb-3 text-center">
                            <div class="foto-box rounded border shadow-sm p-1">
                                <img src="@foto.CaminhoArquivo" alt="Foto @(i + 1)" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
                            </div>
                            <small class="d-block mt-1 fw-bold text-dark">Foto @(i + 1): @foto.Legenda</small>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- DUPLA ASSINATURA EXECUTIVA -->
        <div class="mt-4 pt-3 border-top">
            <p class="text-center text-muted fst-italic" style="font-size: 0.8rem;">
                Declaro que os serviços e manutenções descritos nesta Ordem de Serviço foram executados e testados a contento.
            </p>
            <div class="row text-center mt-4 align-items-end">
                <div class="col-6">
                    <p class="mb-0">__________________________________________</p>
                    <p class="mb-0 fw-bold">José Antônio da C. Montalvão</p>
                    <small class="text-muted fw-bold">Diretor Executivo</small>
                </div>

                <div class="col-6">
                    @if (!string.IsNullOrEmpty(Model.AssinaturaClienteBase64))
                    {
                        <div class="mb-1">
                            <img src="@Model.AssinaturaClienteBase64" style="max-height: 75px; max-width: 250px;" alt="Assinatura Digital" />
                        </div>
                    }
                    else
                    {
                        <p class="mb-0">__________________________________________</p>
                    }
                    <p class="mb-0 fw-bold">Assinatura do Cliente / Responsável</p>
                    <small class="text-muted">Aceite Digital do Serviço</small>
                </div>
            </div>
        </div>

        <!-- RODAPÉ PERMANENTE -->
        <div class="mt-4 pt-2 border-top text-center text-muted" style="font-size: 0.75rem;">
            Smart Control Systemas Ltda. • E-mail: smartcontrolsystemas@gmail.com • Site: www.smartcontrolsystemas.com.br
        </div>
    </div>
</div>

</body>
</html>
