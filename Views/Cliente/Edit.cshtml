@model MEIAdmin.Models.Cliente

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="container mt-3">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Editar Cliente - @Model.RazaoSocial</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <!-- AVISO DE ERROS SE HOUVER -->
                <div asp-validation-summary="All" class="alert alert-danger mb-3" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <!-- CAMPOS OCULTOS ESSENCIAIS PARA VALIDAÇÃO -->
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="DataCadastro" />
                <input type="hidden" asp-for="Ativo" />

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="RazaoSocial" class="form-label fw-bold">Razão Social / Nome</label>
                        <input asp-for="RazaoSocial" class="form-control" required />
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="Contato" class="form-label fw-bold">Pessoa de Contato</label>
                        <input asp-for="Contato" class="form-control" placeholder="Ex: Beto" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group mb-3">
                        <label asp-for="CpfCnpj" class="form-label fw-bold">CPF / CNPJ</label>
                        <input asp-for="CpfCnpj" class="form-control" />
                    </div>

                    <div class="col-md-4 form-group mb-3">
                        <label asp-for="InscEstadual" class="form-label fw-bold">Inscrição Estadual (Opcional)</label>
                        <input asp-for="InscEstadual" class="form-control" placeholder="Deixe em branco se não tiver" />
                    </div>

                    <div class="col-md-4 form-group mb-3">
                        <label asp-for="Telefone" class="form-label fw-bold">Telefone / WhatsApp</label>
                        <input asp-for="Telefone" class="form-control" />
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Email" class="form-label fw-bold">E-mail (para envio de orçamentos)</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="cliente@email.com" />
                </div>

                <h5 class="text-primary mt-3 border-bottom pb-2">Endereço</h5>

                <div class="row">
                    <div class="col-md-8 form-group mb-3">
                        <label asp-for="Endereco" class="form-label fw-bold">Rua / Logradouro</label>
                        <input asp-for="Endereco" class="form-control" />
                    </div>

                    <div class="col-md-4 form-group mb-3">
                        <label asp-for="Numero" class="form-label fw-bold">Número</label>
                        <input asp-for="Numero" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group mb-3">
                        <label asp-for="Bairro" class="form-label fw-bold">Bairro</label>
                        <input asp-for="Bairro" class="form-control" />
                    </div>

                    <div class="col-md-4 form-group mb-3">
                        <label asp-for="Cidade" class="form-label fw-bold">Cidade</label>
                        <input asp-for="Cidade" class="form-control" />
                    </div>

                    <div class="col-md-2 form-group mb-3">
                        <label asp-for="Estado" class="form-label fw-bold">UF</label>
                        <input asp-for="Estado" class="form-control" maxlength="2" placeholder="SP" />
                    </div>

                    <div class="col-md-2 form-group mb-3">
                        <label asp-for="CEP" class="form-label fw-bold">CEP</label>
                        <input asp-for="CEP" class="form-control" />
                    </div>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-primary px-4">Salvar Alterações</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>