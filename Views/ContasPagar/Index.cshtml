@model IEnumerable<MEIAdmin.Models.ContaPagar>

@{
    ViewData["Title"] = "Contas a Pagar";
}

<h2>Contas a Pagar</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Nova Conta</a>

<table class="table table-striped table-hover mt-3">
    <thead class="table-light">
        <tr>
            <th>Valor</th>
            <th>Vencimento</th>
            <th>Data Pagto</th>
            <th>Status</th>
            <th>Fornecedor</th>
            <th>Colaborador</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var conta in Model)
            {
                <tr>
                    <td class="fw-bold">@conta.Valor.ToString("C")</td>
                    <td>@conta.DataVencimento.ToString("dd/MM/yyyy")</td>
                    <td>@(conta.DataPagamento?.ToString("dd/MM/yyyy") ?? "-")</td>
                    <td>
                        @if (conta.Status == "Pago")
                        {
                            <span class="badge bg-success">Pago</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@(conta.Status ?? "Não Pago")</span>
                        }
                    </td>
                    <td>@(conta.Fornecedor?.RazaoSocial ?? "N/A")</td>
                    <td>@(conta.Colaborador?.Nome ?? "N/A")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@conta.Id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Delete" asp-route-id="@conta.Id" class="btn btn-danger btn-sm">Excluir</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">Nenhuma conta cadastrada.</td>
            </tr>
        }
    </tbody>
</table>
