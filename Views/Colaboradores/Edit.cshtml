@model MEIAdmin.Models.Colaborador

@{
    ViewData["Title"] = "Editar Colaborador";
}

<div class="container mt-3">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">✏️ Editar Colaborador - @Model.Nome</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <!-- DADOS BÁSICOS -->
                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="Nome" class="form-label fw-bold">Nome Completo</label>
                        <input asp-for="Nome" class="form-control" required />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="Cargo" class="form-label fw-bold">Cargo / Função</label>
                        <input asp-for="Cargo" class="form-control" required />
                        <span asp-validation-for="Cargo" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="Telefone" class="form-label fw-bold">Telefone / WhatsApp</label>
                        <input asp-for="Telefone" class="form-control" />
                        <span asp-validation-for="Telefone" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="Email" class="form-label fw-bold">E-mail</label>
                        <input asp-for="Email" class="form-control" type="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <!-- BLOCO DE ACESSO: LOGIN, SENHA E PERFIL -->
                <div class="card bg-light border-primary p-3 mb-4 rounded shadow-sm">
                    <h5 class="text-primary fw-bold mb-2">🔐 Acesso ao Sistema e App Mobile</h5>
                    <small class="text-muted d-block mb-3">Defina ou altere os dados de login deste colaborador:</small>

                    <div class="row">
                        <div class="col-md-4 form-group mb-2">
                            <label asp-for="Login" class="form-label fw-bold">Usuário / Login</label>
                            <input asp-for="Login" class="form-control" placeholder="Ex: alan, carlos, jose" />
                            <span asp-validation-for="Login" class="text-danger"></span>
                        </div>

                        <div class="col-md-4 form-group mb-2">
                            <label asp-for="Senha" class="form-label fw-bold">Senha de Acesso</label>
                            <input asp-for="Senha" class="form-control" type="text" placeholder="Digite uma nova senha se quiser alterar" />
                            <span asp-validation-for="Senha" class="text-danger"></span>
                        </div>

                        <div class="col-md-4 form-group mb-2">
                            <label asp-for="Perfil" class="form-label fw-bold">Nível de Acesso (Perfil)</label>
                            <select asp-for="Perfil" class="form-select">
                                <option value="Tecnico" selected="@(Model.Perfil == "Tecnico" ? "selected" : null)">Técnico (Apenas App de O.S. no celular)</option>
                                <option value="Admin" selected="@(Model.Perfil == "Admin" ? "selected" : null)">Administrador (Acesso Total ao Sistema)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- ENDEREÇO -->
                <h5 class="text-dark fw-bold border-bottom pb-2 mb-3">Endereço Residencial</h5>

                <div class="row">
                    <div class="col-md-8 form-group mb-3">
                        <label asp-for="Endereco" class="form-label fw-bold">Rua / Logradouro</label>
                        <input asp-for="Endereco" class="form-control" />
                    </div>

                    <div class="col-md-4 form-group mb-3">
                        <label asp-for="Numero" class="form-label fw-bold">Número</label>
                        <input asp-for="Numero" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group mb-3">
                        <label asp-for="Bairro" class="form-label fw-bold">Bairro</label>
                        <input asp-for="Bairro" class="form-control" />
                    </div>

                    <div class="col-md-4 form-group mb-3">
                        <label asp-for="Cidade" class="form-label fw-bold">Cidade</label>
                        <input asp-for="Cidade" class="form-control" />
                    </div>

                    <div class="col-md-2 form-group mb-3">
                        <label asp-for="Estado" class="form-label fw-bold">UF</label>
                        <input asp-for="Estado" class="form-control" maxlength="2" />
                    </div>

                    <div class="col-md-2 form-group mb-3">
                        <label asp-for="CEP" class="form-label fw-bold">CEP</label>
                        <input asp-for="CEP" class="form-control" />
                    </div>
                </div>

                <!-- DADOS DE CONTRATAÇÃO -->
                <h5 class="text-dark fw-bold border-bottom pb-2 mb-3">Contrato</h5>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="DataContratacao" class="form-label fw-bold">Data de Contratação</label>
                        <input asp-for="DataContratacao" type="date" class="form-control" />
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="DataDemissao" class="form-label fw-bold">Data de Demissão (Opcional)</label>
                        <input asp-for="DataDemissao" type="date" class="form-control" />
                    </div>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-success px-4 btn-lg fw-bold">Salvar Alterações</button>
                    <a asp-action="Index" class="btn btn-secondary btn-lg">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}