@model MEIAdmin.Models.ContaReceber

@{
    ViewData["Title"] = "Excluir Conta a Receber";
}

<div class="container mt-3">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">⚠️ Confirmar Exclusão de Conta a Receber</h4>
        </div>
        <div class="card-body p-4">
            <h5 class="text-danger fw-bold mb-3">Tem certeza de que deseja excluir este registro?</h5>

            <div class="card bg-light mb-4">
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">Descrição:</dt>
                        <dd class="col-sm-9 fw-bold">@Model.Descricao</dd>

                        <dt class="col-sm-3 text-muted">Cliente:</dt>
                        <dd class="col-sm-9">@(Model.Cliente?.RazaoSocial ?? "Não informado")</dd>

                        <dt class="col-sm-3 text-muted">Valor:</dt>
                        <dd class="col-sm-9 text-primary fw-bold fs-5">@Model.Valor.ToString("C")</dd>

                        <dt class="col-sm-3 text-muted">Vencimento:</dt>
                        <dd class="col-sm-9">@Model.DataVencimento.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-3 text-muted">Status:</dt>
                        <dd class="col-sm-9">
                            <span class="badge @(Model.Status == "Recebido" ? "bg-success" : "bg-warning text-dark")">
                                @(Model.Status ?? "Pendente")
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger px-4 btn-lg">Sim, Excluir</button>
                <a asp-action="Index" class="btn btn-secondary btn-lg">Cancelar</a>
            </form>
        </div>
    </div>
</div>